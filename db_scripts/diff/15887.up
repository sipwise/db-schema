use provisioning;
set autocommit=0;

SELECT id INTO @vpg_id FROM voip_preference_groups WHERE name = 'Media Codec Transcoding Options';

INSERT INTO voip_preferences (voip_preference_groups_id, attribute, label, type, max_occur, usr_pref, prof_pref, dom_pref, peer_pref, contract_pref, modify_timestamp, internal, expose_to_customer, data_type, read_only, description)
VALUES
  (@vpg_id, 'transcode_G726_16', "Transcode to G.726 16 kbps", 0, 1, 1, 1, 1, 1, 0, NOW(), 0, 0, 'boolean', 0, 'Always offer the audio codec G.726 (8 kHz/16 kbps) to this subscriber or peer.'),
  (@vpg_id, 'transcode_G726_24', "Transcode to G.726 24 kbps", 0, 1, 1, 1, 1, 1, 0, NOW(), 0, 0, 'boolean', 0, 'Always offer the audio codec G.726 (8 kHz/24 kbps) to this subscriber or peer.'),
  (@vpg_id, 'transcode_G726_32', "Transcode to G.726 32 kbps", 0, 1, 1, 1, 1, 1, 0, NOW(), 0, 0, 'boolean', 0, 'Always offer the audio codec G.726 (8 kHz/32 kbps) to this subscriber or peer.'),
  (@vpg_id, 'transcode_G726_40', "Transcode to G.726 40 kbps", 0, 1, 1, 1, 1, 1, 0, NOW(), 0, 0, 'boolean', 0, 'Always offer the audio codec G.726 (8 kHz/40 kbps) to this subscriber or peer.');

commit;

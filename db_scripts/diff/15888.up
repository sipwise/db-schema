use provisioning;
set autocommit=0;

SELECT id INTO @vpg_id FROM voip_preference_groups WHERE name = 'Media Codec Transcoding Options';

INSERT INTO voip_preferences (voip_preference_groups_id, attribute, label, type, max_occur, usr_pref, prof_pref, dom_pref, peer_pref, contract_pref, modify_timestamp, internal, expose_to_customer, data_type, read_only, description)
VALUES
  (@vpg_id, 'transcode_preference', "Offer codecs for transcoding in the given order of preference",  0, 1, 1, 1, 1, 1, 0, NOW(), 0, 0, 'string', 0, 'List of codecs, separated by commas, to determine the order of preference for transcoded codecs.');

commit;
